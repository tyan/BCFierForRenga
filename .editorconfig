# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# General rules for all files
[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

# C# files
[*.cs]
indent_size = 2
indent_style = space