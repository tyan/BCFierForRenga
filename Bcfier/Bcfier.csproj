<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>Bcfier</RootNamespace>
    <AssemblyName>Bcfier</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Renga.WPF.Styles">
      <HintPath>..\packages\Renga.WPF.Styles\Renga.WPF.Styles.dll</HintPath>
    </Reference>
    <Reference Include="PresentationFramework.Aero" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
    <Compile Remove="UserControls\IssuesPanel.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\no_image.png" />
    <Content Include="Assets\i24_delete.png" CopyToOutputDirectory="Always" />
    <Content Include="Assets\i24_edit.png" CopyToOutputDirectory="Always" />
    <Content Include="Assets\i24_open.png" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="SampleBcfFile.xaml" />
    <None Include="SampleBcfFile.xaml" />
  </ItemGroup>

</Project>