## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.


# Visual Studo
*.suo
*.user
.vs/
launchSettings.json

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Oo]bj/
x64/
x86/
build/

# NUNIT
TestResult.xml

# NuGet Packages
*.nupkg

# The packages folder can be ignored because of Package Restore
**/packages/*

# Agent development
_agents/

# Common temporary files
*.log