<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>Bcfier.RengaPlugin</RootNamespace>
    <AssemblyName>Bcfier.Renga</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Renga.NET.PluginUtility">
      <HintPath>..\..\RengaSDK\Net\Renga.NET.PluginUtility.dll</HintPath>
    </Reference>
    <Reference Include="Renga.WPF.Styles">
      <HintPath>..\packages\Renga.WPF.Styles\Renga.WPF.Styles.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <COMFileReference Include="..\..\RengaSDK\tlb\RengaCOMAPI.tlb" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bcfier\Bcfier.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BCFier.rndesc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\BCFierIcon16x16.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>